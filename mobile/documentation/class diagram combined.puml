@startuml
title studyhub flutter class diagram


package "Global content" {
  class "AppGlobals" as AppGlobals <<top-level>> {
    +displayName : String
    +userID : String
    +token : String
    +themeData : ValueNotifier<SavedTheme>
    +showError(context, message) : void
    +validDate(value) : bool
    +receiveTheme(theme) : String
    +receiveTextSize(textSize) : double
    -_apiHeaders(authenticated) : Map<String, String>
    +main() : Future<void>
  }

  class SavedTheme {
    +theme : String
    +textSize : double
  }

  class TextSizeScale {
    +systemScaler : TextScaler
    +preferenceFactor : double
    +scale(fontSize) : double
  }
}

class User {
    +id : String
    +name : String
    +email : String
    +isVerified : bool
    +fromJson(json) : User
  }


  class Group {
    +id : String
    +name : String
    +color : String
    +sortOrder : int
    +taskCount : int
    +fromJson(json) : Group
  }

  class Task {
    +id : String
    +userId : String
    +name : String
    +importance : double
    +estPomodoros : int
    +priorityScore : double
    +sortOrder : int
    +completed : bool
    +description : String?
    +groupId : String?
    +parentTaskId : String?
    +dueDate : String?
    +fromJson(json) : Task
  }
  
  class TaskCard {
    +task : Task
    +taskEdit : VoidCallback
    +taskDelete : VoidCallback
    +taskCompleted : ValueChanged<bool>
    +build(context) : Widget
  }
  



package "API providers" {
  class LoginAPI {
    +baseUrl : String
    +login(email, password) : Future<User?>
    +register(displayName, email, password) : Future<int>
    +forgotPassword(email) : Future<int>
  }

  class TaskAPI {
    +baseUrl : String
    +getTasks(filters) : Future<List<Task>>
    +getTaskById(id) : Future<Task?>
    +createTask(...) : Future<int>
    +deleteTask(id) : Future<int>
    +patchTask(id, changes) : Future<Task>
    +createGroup(name, color) : Future<int>
    +getGroups() : Future<List<Group>>
    +patchGroup(...) : Future<Group?>
    +deleteGroup(id) : Future<int>
    +searchTasks(part) : Future<List<Task>>
  }

  class OptionAPI {
    +baseUrl : String
    +getCurrentUserTheme() : Future<String>
    +patchCurrentUser(...) : Future<int>
  }
  
  class "TaskActions<T>" as TaskActions <<mixin>> {
    +taskAPI : TaskAPI
    +loadedTasks : Future<List<Task>>
    +refreshTasks() : void
    +editTask(task) : Future<void>
    +deleteTask(task) : Future<void>
    +setTaskCompleted(task, completed) : Future<void>
  }
}



package "Application root" {
  class CombinedMain {
    +lightMode : ThemeData
    +darkMode : ThemeData
    +highContrastMode : ThemeData
    +build(context) : Widget
  }
}

package "Task pages" {
  class HomePage {
    +taskAPI : TaskAPI
    +loadedTasks : Future<List<Task>>
    +searchedTasks : Future<List<Task>>
    +loadedGroups : Future<List<Group>>
    +currentPageIndex : int
    +searchController : TextEditingController
    +initState() : void
    +dispose() : void
    +taskRefresh() : void
    +openPage(route) : Future<void>
    +taskList(...) : Widget
    +groupList() : Widget
    +groupEdit(group) : Future<void>
    +groupDelete(group) : Future<void>
    +build(context) : Widget
  }

  class ViewGroupPage {
    +group : Group
    +taskAPI : TaskAPI
    +loadedTasks : Future<List<Task>>
    +initState() : void
    +taskList(...) : Widget
    +build(context) : Widget
  }
  
  class NewItemPage {
    +taskAPI : TaskAPI
    +groups : Future<List<Group>>
    +taskName : String
    +description : String
    +groupId : String
    +importance : double
    +dueDate : String
    +estPomodoros : int
    +taskSuccess : int
    +initState() : void
    +build(context) : Widget
  }

  class EditTaskPage {
    +task : Task
    +taskAPI : TaskAPI
    +nameController : TextEditingController
    +descriptionController : TextEditingController
    +pomodorosController : TextEditingController
    +dueDateController : TextEditingController
    +initialDate : String
    +importance : double
    +saving : bool
    +initState() : void
    +dispose() : void
    +save() : Future<void>
    +build(context) : Widget
  }

  class NewGroupPage {
    +taskAPI : TaskAPI
    +groupName : String
    +groupColor : String
    +build(context) : Widget
  }

  class EditGroupPage {
    +group : Group
    +taskAPI : TaskAPI
    +groupName : String
    +groupColor : String
    +initState() : void
    +build(context) : Widget
  }
  }
  
  package "Login pages" {

  class LoginPage {
    +email : String
    +password : String
    +emailController : TextEditingController
    +passwordController : TextEditingController
    +login : LoginAPI
    +optionAPI : OptionAPI
    +loadSavedTheme() : Future<void>
    +dispose() : void
    +build(context) : Widget
  }

 
  class RegisterPage {
    +email : String
    +passwordOne : String
    +passwordTwo : String
    +emailController : TextEditingController
    +nameController : TextEditingController
    +passwordControllerOne : TextEditingController
    +passwordControllerTwo : TextEditingController
    +login : LoginAPI
    +dispose() : void
    +build(context) : Widget
  }

  
   class EmailCodeConfirm {
     +build(context) : Widget
   }
  
   class PasswordCodeConfirm {
     +build(context) : Widget
   }
  
  class PasswordConfirmationSend {
    +emailController : TextEditingController
    +email : String
    +login : LoginAPI
    +dispose() : void
    +build(context) : Widget
  }
  }

  class SettingsPage {
    +theme : String
    +textSize : double
    +importance : double
    +dueDate : double
    +time : double
    +optionAPI : OptionAPI
    +displayNameController : TextEditingController
    +importanceController : TextEditingController
    +dueDateController : TextEditingController
    +timeController : TextEditingController
    +dispose() : void
    +build(context) : Widget
  }



' Mixin usage formerly implemented by the corresponding page states
HomePage ..> TaskActions : uses
ViewGroupPage ..> TaskActions : uses

' Application state and preference relationships
AppGlobals o-- SavedTheme : themeData
CombinedMain ..> AppGlobals : observes themeData
CombinedMain ..> TextSizeScale : applies text scaling
LoginPage ..> AppGlobals : updates themeData
SettingsPage ..> AppGlobals : updates themeData

' Model relationships
Task "0..*" --> "0..1" Group : groupId
TaskCard "1" o-- "1" Task
EditTaskPage "1" o-- "1" Task
EditGroupPage "1" o-- "1" Group
ViewGroupPage "1" o-- "1" Group

' API dependencies
LoginAPI ..> User : creates
User ..> AppGlobals : sets token / identity
TaskAPI ..> Task : creates
TaskAPI ..> Group : creates
OptionAPI ..> AppGlobals : authenticated headers

' Page dependencies
HomePage ..> TaskAPI
HomePage ..> TaskCard : builds
ViewGroupPage ..> TaskAPI
ViewGroupPage ..> TaskCard : builds
LoginPage ..> LoginAPI
LoginPage ..> OptionAPI
RegisterPage ..> LoginAPI
PasswordConfirmationSend ..> LoginAPI
NewItemPage ..> TaskAPI
NewItemPage ..> Group
EditTaskPage ..> TaskAPI
NewGroupPage ..> TaskAPI
EditGroupPage ..> TaskAPI
SettingsPage ..> OptionAPI
TaskActions ..> TaskAPI
TaskActions ..> Task

' Routes configured by CombinedMain
CombinedMain ..> LoginPage : "/"
CombinedMain ..> HomePage : "/home"
CombinedMain ..> NewItemPage : "/newitem"
CombinedMain ..> RegisterPage : "/register"
CombinedMain ..> EmailCodeConfirm : "/email"
CombinedMain ..> PasswordConfirmationSend : "/password"
CombinedMain ..> PasswordCodeConfirm : "/passwordcode"
CombinedMain ..> NewGroupPage : "/createGroup"
CombinedMain ..> SettingsPage : "/settings"

@enduml
